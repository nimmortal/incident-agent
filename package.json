{
  "name": "incident-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "node --import tsx src/agent-cli.ts",
    "doctor": "node --import tsx src/doctor.ts",
    "doctor:strict": "node --import tsx src/doctor.ts --strict --verify-sources",
    "schema-cache": "node --import tsx src/schema-cache.ts",
    "goal": "node --import tsx src/agent-cli.ts goal",
    "investigate": "node --import tsx src/agent-cli.ts investigate",
    "test": "node --import tsx --test",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=60 --test-coverage-branches=60 --test-coverage-functions=40 --import tsx --test",
    "ui": "node --import tsx src/agent-cli.ts ui",
    "dashboard": "node --import tsx src/agent-cli.ts ui --dashboard",
    "poll": "node --import tsx src/poller.ts",
    "evaluate": "node --import tsx src/evaluate.ts",
    "check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  }
}
